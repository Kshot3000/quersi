[server]
# Bind all interfaces so published Docker ports reach the service.
host = "0.0.0.0"
port = 6767
cors_allowed_origins = []

[logging]
level = "info"

[remote_configs]
# Resolved relative to this TOML file → /app/wallet_config.json when mounted.
# Mount the host-managed flags file at that path (see README Docker section).
wallet_configs_file = "../wallet_config.json"

[geo]
# Blocked countries and ranges for the NEAR Intents gate; mounted like wallet_config.json.
config_file = "../geo_config.json"

[exchange_rate]
# https://www.exchangerate-api.com/ — v6 key for latest/{base} rates
# Prefer REMOTE_CONFIG__EXCHANGE_RATE__API_KEY in production.
api_key = "change-me"

[risk_checker]
# Prefer REMOTE_CONFIG__RISK_CHECKER__ETHERSCAN_API_KEY / INFURA_API_KEY in production.
etherscan_api_key = "change-me"
etherscan_base_url = "https://api.etherscan.io/v2/api?chainid=1"
infura_api_key = "change-me"
infura_base_url = "https://mainnet.infura.io/v3"
etherscan_calls_per_sec = 3
max_concurrent_requests = 1
